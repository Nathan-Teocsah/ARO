\newcommand{\doublebar}[1]{%
\noindent
\begin{tikzpicture}
\node[
  inner xsep=0em,
  inner ysep=0.6em,
  text width=\linewidth-2em,
  align=left
] (box) {#1};
\draw[line width=0.35pt] ([xshift=-6pt]box.north west) -- ([xshift=-6pt]box.south west);
\draw[line width=0.35pt] ([xshift=-9pt]box.north west) -- ([xshift=-9pt]box.south west);
\end{tikzpicture}
}
\newcommand{\simplebar}[1]{%
\noindent
