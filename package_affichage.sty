\newcommand{\theoremcolorbox}[2]{%
	\def\theoremframecommand##1{%
		\begin{tcolorbox}[
			colframe=#1,
			colback=#2,
			arc=3mm,
			boxrule=0.8pt,
			left=6pt,
			right=6pt,
			top=6pt,
			bottom=6pt
			]
			##1
		\end{tcolorbox}
	}%
}

\newcommand{\theoremcolorboxdot}[2]{%
	\def\theoremframecommand##1{%
		\begin{tcolorbox}[
			enhanced,
			arc=1.5mm,
			frame hidden,
			colback=#2,
			left=6pt,
			right=6pt,
			top=6pt,
			bottom=6pt,
			borderline={0.5mm}{0mm}{dotted,#1}
		]
			##1
		\end{tcolorbox}
	}%
}


